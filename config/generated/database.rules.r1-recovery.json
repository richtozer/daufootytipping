{
  "rules": {
    "AppConfig": {
      ".read": "true",
      ".write": "(auth != null && (auth.uid === 'pxxLNwpafXPsHOcKEiWk6JOtudi2' || auth.uid === 'UTKZKKqcGkcWvc8xv8zaoGwVFkg1' || auth.uid === '7sjTXDkaYoRFwLSWzrCgcXuyTSD2' || auth.uid === '2lnOuVShdqdEhnGp28GZYcViuok1'))"
    },
    "Teams": {
      ".read": "true",
      ".write": "(auth != null && (auth.uid === 'pxxLNwpafXPsHOcKEiWk6JOtudi2' || auth.uid === 'UTKZKKqcGkcWvc8xv8zaoGwVFkg1' || auth.uid === '7sjTXDkaYoRFwLSWzrCgcXuyTSD2' || auth.uid === '2lnOuVShdqdEhnGp28GZYcViuok1'))"
    },
    "AllDAUComps": {
      ".read": "true",
      ".write": "(auth != null && (auth.uid === 'pxxLNwpafXPsHOcKEiWk6JOtudi2' || auth.uid === 'UTKZKKqcGkcWvc8xv8zaoGwVFkg1' || auth.uid === '7sjTXDkaYoRFwLSWzrCgcXuyTSD2' || auth.uid === '2lnOuVShdqdEhnGp28GZYcViuok1'))"
    },
    "DAUCompsGames": {
      ".read": "true",
      ".write": "(auth != null && (auth.uid === 'pxxLNwpafXPsHOcKEiWk6JOtudi2' || auth.uid === 'UTKZKKqcGkcWvc8xv8zaoGwVFkg1' || auth.uid === '7sjTXDkaYoRFwLSWzrCgcXuyTSD2' || auth.uid === '2lnOuVShdqdEhnGp28GZYcViuok1'))",
      "$compDBKey": {
        ".indexOn": "DateUtc"
      }
    },
    "AllTippers": {
      ".read": "true",
      ".indexOn": [
        "authuid",
        "email",
        "logon"
      ],
      ".write": "(auth != null && (auth.uid === 'pxxLNwpafXPsHOcKEiWk6JOtudi2' || auth.uid === 'UTKZKKqcGkcWvc8xv8zaoGwVFkg1' || auth.uid === '7sjTXDkaYoRFwLSWzrCgcXuyTSD2' || auth.uid === '2lnOuVShdqdEhnGp28GZYcViuok1'))",
      "$tipperId": {
        ".write": "(auth != null && auth.token.firebase.sign_in_provider !== 'anonymous') && !data.exists() && newData.child('tipperRole').val() === 'tipper' && newData.child('authuid').val() === auth.uid && !newData.hasChild('compsParticipatedIn')",
        ".validate": "newData.hasChildren(['authuid', 'tipperRole'])",
        "authuid": {
          ".validate": "newData.isString()"
        },
        "tipperRole": {
          ".validate": "newData.isString() && (newData.val() === 'admin' || newData.val() === 'tipper')"
        },
        "compsParticipatedIn": {
          ".validate": "newData.hasChildren() || newData.val() === null"
        },
        "name": {
          ".write": "(auth != null && auth.token.firebase.sign_in_provider !== 'anonymous')"
        },
        "email": {
          ".write": "(auth != null && auth.token.firebase.sign_in_provider !== 'anonymous')"
        },
        "logon": {
          ".write": "(auth != null && auth.token.firebase.sign_in_provider !== 'anonymous')"
        },
        "photoURL": {
          ".write": "(auth != null && auth.token.firebase.sign_in_provider !== 'anonymous')"
        },
        "isAnonymous": {
          ".write": "(auth != null && auth.token.firebase.sign_in_provider !== 'anonymous')"
        },
        "acctCreatedUTC": {
          ".write": "(auth != null && auth.token.firebase.sign_in_provider !== 'anonymous')"
        },
        "acctLoggedOnUTC": {
          ".write": "(auth != null && auth.token.firebase.sign_in_provider !== 'anonymous')"
        },
        "active": {},
        "tipperID": {}
      }
    },
    "AllTippersTokens": {
      ".read": "auth != null",
      "$tipperId": {
        "$token": {
          ".write": "(auth != null && auth.token.firebase.sign_in_provider !== 'anonymous')"
        }
      }
    },
    "AllTips": {
      ".read": "true",
      "$comp": {
        "$tipperId": {
          ".write": "(auth != null && (auth.uid === 'pxxLNwpafXPsHOcKEiWk6JOtudi2' || auth.uid === 'UTKZKKqcGkcWvc8xv8zaoGwVFkg1' || auth.uid === '7sjTXDkaYoRFwLSWzrCgcXuyTSD2' || auth.uid === '2lnOuVShdqdEhnGp28GZYcViuok1'))",
          "$game": {
            ".write": "(auth != null && auth.token.firebase.sign_in_provider !== 'anonymous')"
          }
        }
      }
    },
    "Stats": {
      ".read": "true",
      "$comp": {
        "live_scores_backend_v1": {
          "$game": {
            "current": {
              ".write": "(auth != null && auth.token.firebase.sign_in_provider !== 'anonymous')"
            },
            "history": {
              "$key": {
                ".write": "(auth != null && auth.token.firebase.sign_in_provider !== 'anonymous')"
              }
            }
          }
        },
        "game_stats_v3": {
          ".write": "(auth != null && auth.token.firebase.sign_in_provider !== 'anonymous')"
        },
        "live_scores_v3": {
          ".write": "(auth != null && auth.token.firebase.sign_in_provider !== 'anonymous')"
        },
        "round_stats_v3": {
          ".write": "(auth != null && auth.token.firebase.sign_in_provider !== 'anonymous')"
        },
        "scoring_audit_v3": {
          ".write": "(auth != null && auth.token.firebase.sign_in_provider !== 'anonymous')"
        },
        "admin_scoring_freshness_probe": {
          ".write": "(auth != null && auth.token.firebase.sign_in_provider !== 'anonymous')"
        }
      }
    },
    "Diagnostics": {
      ".read": "true"
    }
  }
}
